{
  "name": "bothub",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun --bun vite build",
    "check:peers": "bun scripts/check-peer-deps.ts",
    "coverage": "vitest run --coverage",
    "dev": "bun --bun vite dev --port 3000",
    "docs:list": "bun scripts/docs-list.ts",
    "format": "oxfmt --write",
    "lint": "bun run lint:oxlint",
    "lint:fix": "oxlint --type-aware --tsconfig ./tsconfig.oxlint.json ./src ./packages/bothub/src ./packages/schema/src --fix && bun run format",
    "lint:oxlint": "oxlint --type-aware --tsconfig ./tsconfig.oxlint.json ./src ./packages/bothub/src ./packages/schema/src",
    "preinstall": "bunx only-allow bun",
    "preview": "bun --bun vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:e2e:local": "bash scripts/run-playwright-local.sh",
    "test:pw": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@hanzo/data": "1.2.4",
    "@hanzo/gui": "8.3.1",
    "@hanzo/ui": "8.27.0",
    "@hanzogui/animations-css": "8.3.1",
    "@hanzogui/config": "8.3.1",
    "@hanzogui/lucide-icons-2": "8.3.1",
    "@hanzogui/telemetry": "8.3.1",
    "@hanzogui/toast": "8.3.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-router": "1.170.8",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.14",
    "@tanstack/router-plugin": "^1.168.35",
    "@vercel/analytics": "^2.0.1",
    "bothub-schema": "workspace:*",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "h3": "^2.0.1-rc.29",
    "lucide-react": "^1.33.0",
    "monaco-editor": "^0.56.0",
    "nitro": "3.0.260522-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "^0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "only-allow": "^1.2.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "7.0.2",
    "undici": "^8.10.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
